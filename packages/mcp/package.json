{
  "name": "@eidentic/mcp",
  "version": "0.3.1",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/mcp"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eidentic/core": "workspace:*",
    "@eidentic/types": "workspace:*"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": ">=1.20"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.0.0"
  },
  "description": "Model Context Protocol (MCP) host and server for Eidentic — expose agent tools via MCP, or consume remote MCP servers, with OAuth 2.1 support.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "mcp",
    "model-context-protocol",
    "tools",
    "oauth"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
