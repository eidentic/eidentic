{
  "name": "@eidentic/studio",
  "version": "0.1.6",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/studio"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "ui/dist",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "cd ui && vite build && cd .. && tsup src/index.ts --format esm,cjs --dts --clean",
    "build:ts": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eidentic/core": "workspace:*",
    "@eidentic/model": "workspace:*",
    "@eidentic/types": "workspace:*",
    "@eidentic/server": "workspace:*",
    "@eidentic/workflow": "workspace:*",
    "@hono/node-server": "^2.0.0",
    "hono": "^4.12.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5"
  },
  "description": "Local dev studio for Eidentic — inspect agent sessions, memory, skills, and workflow runs via a web dashboard.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "studio",
    "dashboard",
    "devtools",
    "debug"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
