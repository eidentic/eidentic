{
  "name": "@eidentic/cli",
  "version": "0.4.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The eidentic command-line tool — dev server, project init, component scaffolding, and health diagnostics.",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/cli"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "eidentic": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "LICENSE",
    "README.md"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean",
    "typecheck": "tsc --noEmit",
    "typecheck:templates": "tsc --noEmit -p tsconfig.templates.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@eidentic/core": "workspace:*",
    "@eidentic/eval": "workspace:*",
    "@eidentic/server": "workspace:*",
    "@eidentic/studio": "workspace:*",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "jiti": "^2.7.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@eidentic/react": "workspace:*",
    "@eidentic/skills": "workspace:^",
    "@eidentic/types": "workspace:*",
    "@types/react": "^19.0.0",
    "hono": "^4.12.32",
    "react": "^19.2.8",
    "zod": "^4.0.0"
  },
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "cli",
    "dev-server",
    "scaffold"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
