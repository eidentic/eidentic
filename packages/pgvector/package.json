{
  "name": "@eidentic/pgvector",
  "version": "0.2.2",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/pgvector"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eidentic/types": "workspace:*"
  },
  "peerDependencies": {
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.3",
    "pg": "^8.22.0",
    "@types/pg": "^8.11.0"
  },
  "description": "pgvector adapter for Eidentic — vector search over PostgreSQL (pg / pglite) using the pgvector extension.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "pgvector",
    "postgres",
    "vector-store",
    "memory"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
