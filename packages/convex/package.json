{
  "name": "@eidentic/convex",
  "version": "0.6.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/convex"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js",
      "require": "./dist/schema.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "import": "./dist/component/convex.config.js",
      "require": "./dist/component/convex.config.cjs"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "import": "./dist/component.js",
      "require": "./dist/component.cjs"
    },
    "./app-functions": {
      "types": "./dist/app-functions/index.d.ts",
      "import": "./dist/app-functions/index.js",
      "require": "./dist/app-functions/index.cjs"
    },
    "./app-functions/schema": {
      "types": "./dist/app-functions/schema.d.ts",
      "import": "./dist/app-functions/schema.js",
      "require": "./dist/app-functions/schema.cjs"
    },
    "./app-functions/server": {
      "types": "./dist/app-functions/server.d.ts",
      "import": "./dist/app-functions/server.js",
      "require": "./dist/app-functions/server.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/schema.ts src/server.ts src/component.ts src/component/convex.config.ts src/component/schema.ts src/component/functions.ts src/app-functions/index.ts src/app-functions/schema.ts src/app-functions/server.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@eidentic/types": "workspace:*"
  },
  "peerDependencies": {
    "convex": ">=1.17"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "convex": "^1.41.0",
    "convex-test": "^0.0.53"
  },
  "description": "Convex store adapter for Eidentic — durable agent memory, session state, and a temporal knowledge graph backed by Convex (StorePort + GraphPort + VectorPort).",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "convex",
    "store",
    "vector-store",
    "memory",
    "knowledge-graph"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
