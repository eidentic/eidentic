{
  "name": "@eidentic/model",
  "version": "0.2.4",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/model"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit",
    "gen:prices": "tsx scripts/gen-prices.ts"
  },
  "dependencies": {
    "@eidentic/types": "workspace:*",
    "ai": "^6.0.207"
  },
  "peerDependencies": {
    "ollama-ai-provider": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "ollama-ai-provider": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "tsx": "^4.19.0"
  },
  "description": "Model and embedder wrappers for Eidentic — AIModel and AIEmbedder over AI SDK providers, with live price tables and Ollama support.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "model",
    "embedder",
    "llm",
    "ollama"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
