{
  "name": "@eidentic/tools",
  "version": "0.1.2",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/tools"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eidentic/core": "workspace:*",
    "@eidentic/types": "workspace:*",
    "zod": "^4.0.0"
  },
  "description": "Built-in agent tools for Eidentic — file I/O, bash execution, web fetch, web search (Tavily / Exa / Serper / SearXNG), and sandbox confinement.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "tools",
    "bash",
    "file-tools",
    "web-search"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
