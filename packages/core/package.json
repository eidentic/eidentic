{
  "name": "@eidentic/core",
  "version": "0.2.0",
  "type": "module",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eidentic/eidentic.git",
    "directory": "packages/core"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eidentic/types": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eidentic/model": "workspace:*",
    "@eidentic/skills": "workspace:*"
  },
  "description": "Core agent primitives for Eidentic — the Agent class, tool registry, memory/graph/skill tools, strategies, guardrails, and permission model.",
  "keywords": [
    "ai",
    "agents",
    "typescript",
    "eidentic",
    "agent",
    "tools",
    "memory",
    "react-loop"
  ],
  "homepage": "https://github.com/eidentic/eidentic#readme",
  "bugs": {
    "url": "https://github.com/eidentic/eidentic/issues"
  },
  "engines": {
    "node": ">=22"
  }
}
